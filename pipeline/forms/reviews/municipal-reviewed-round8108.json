      "sourceIssues": [
        "현행2026.10.1상위조례와현재정부24의 감면대상 세부표현에 차이가 있어 이서식만으로 자격·감면율을단정하지않고 현행조례 및 접수기관심사를따르도록 조건을표시한다."
      ],
      "unselectedPartsReviewed": [
        {
          "number": "별지 제2호 하단",
          "title": "봉안당 부부단 사용(재사용)신고증",
          "author": "하남시·관리기관",
          "role": "institution_issued",
          "reason": "수리후기관이작성·교부하는신고증"
        }
      ],
      "displayTitle": "봉안당 부부단 사용(재사용)신고서",
      "coordinatorApproved": true,
      "coordinatorReason": "실제원본 전체766자에서 상단 이용자 신고·서명과 하단 기관발급 신고증을 구별해 읽었다. 현행 상위조례2173843 전체15조·9부칙 및 규칙2063871 전체조문·부칙을 읽었다. 조례 제5조·제6조제3항·제8조제2항·제6항, 규칙 제2조제1항제2호가 사용신고/변경을 지정한다. 상위조례제6조는 감면사유 증빙을 붙여 사용신고할 경우 사용료를감면할수있도록 직접규정하므로 단순한동일법규확장이아니다. 현재정부24 정확사업은 마루공원 방문접수와 장례식장·봉안당감면 및 감면증빙제출을 안내한다.",
      "currentAnnexBinding": {
        "binding": "bound",
        "bindingReason": "OFFICIAL_ANNEX_BOUND_WITH_SAME_FILE",
        "officialAnnexId": "22288655",
        "officialAnnexNumber": "3",
