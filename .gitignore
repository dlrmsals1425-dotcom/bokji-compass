# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 복지나침반 additions
/.venv-pipeline
/pipeline/raw/
/test-results/
/playwright-report/
/blob-report/
!.env.example

# 참고 사이트 캡처(내부 참고용, 저작권상 커밋하지 않음)
shots/ref-*.png

# 작업 로그·임시 산출물 (커밋하지 않음)
/logs/
/pipeline/out/scenarios*
/.next/
/node_modules/
/.venv-stt/
/.models/

# Python import/test caches
__pycache__/
*.py[cod]
